<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ site.dedication }}">
  <meta name="robots" content="noai, noimageai">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <header class="site-header">
    <p class="eyebrow">{{ site.eyebrow }}</p>
    <div class="site-brand">
      <img class="header-emblem" src="{{ '/uploads/emblem-lev.png' | url }}" alt="">
      <a class="site-title" href="{{ '/' | url }}">{{ site.title }}</a>
      <img class="header-emblem" src="{{ '/uploads/emblem-zirka.png' | url }}" alt="">
    </div>
    <div class="rule-double" aria-hidden="true"></div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="rule-double" aria-hidden="true"></div>
    <p>{{ site.footer }}</p>
  </footer>
</body>
</html>
