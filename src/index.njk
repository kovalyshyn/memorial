---
layout: base.njk
---
<p class="dedication">{{ site.dedication }}</p>

<h2 class="section-label">{{ site.unitsLabel }}</h2>

<nav class="unit-list" aria-label="{{ site.unitsLabel }}">
  {% for unit in collections.units %}
    {% set persons = collections.fallen | withUnit(unit.fileSlug) %}
    <a class="unit-row" href="{{ unit.url | url }}">
      <span class="unit-name">{{ unit.data.title }}</span>
      <span class="unit-count" aria-label="Кількість записів">{{ persons.length }}</span>
    </a>
  {% endfor %}
</nav>
